# Copy this file to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is read on start-up by marketpulse/env.py and is listed in .gitignore,
# so nothing in it is ever committed. A real environment variable takes
# precedence over anything set here.

# ---------------------------------------------------------------------------
# Language models. All optional: without them the AI employees answer from
# built-in templates, and every reply is labelled "Template reply".
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Ollama runs locally and needs no key.

# ---------------------------------------------------------------------------
# Email. Optional: without these an approved outreach email is printed to the
# terminal instead of being sent, and the Configurations page says so.
#
# For Gmail this must be an App Password, not the account password, and the
# account needs two-step verification:  https://myaccount.google.com/apppasswords
# Google shows it in four groups of four; the spaces are ignored.
# ---------------------------------------------------------------------------
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Only needed for a provider other than Gmail.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# ---------------------------------------------------------------------------
# Production deployment. Leave these unset for local development.
#
# To run production-grade, set:
#   AIWORKFORCE_DEBUG=0       turn DEBUG off (detailed error pages disabled)
#   SECRET_KEY=<long random>  a real secret; never use the built-in dev default
#   ALLOWED_HOSTS=a.com,b.com comma-separated hosts the server will answer for
#   AIWORKFORCE_SSL=1         HTTPS redirect + secure cookies (on by default
#                             once DEBUG is off)
#   DJANGO_LOG_LEVEL=INFO     logging verbosity (DEBUG/INFO/WARNING/ERROR)
#
# `python manage.py check --deploy` must report no issues before going live.
# ---------------------------------------------------------------------------
# AIWORKFORCE_DEBUG=0
# SECRET_KEY=
# ALLOWED_HOSTS=
# AIWORKFORCE_SSL=1
# DJANGO_LOG_LEVEL=INFO
