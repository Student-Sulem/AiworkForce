# Copy this file to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is read on start-up by marketpulse/env.py and is listed in .gitignore,
# so nothing in it is ever committed. A real environment variable takes
# precedence over anything set here.

# ---------------------------------------------------------------------------
# Language models. All optional: without them the AI employees answer from
# built-in templates, and every reply is labelled "Template reply".
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Ollama runs locally and needs no key.

# ---------------------------------------------------------------------------
# Email. Optional: without these an approved outreach email is printed to the
# terminal instead of being sent, and the Configurations page says so.
#
# For Gmail this must be an App Password, not the account password, and the
# account needs two-step verification:  https://myaccount.google.com/apppasswords
# Google shows it in four groups of four; the spaces are ignored.
# ---------------------------------------------------------------------------
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Only needed for a provider other than Gmail.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
